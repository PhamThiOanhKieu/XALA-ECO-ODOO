<odoo>
    <record id="seq_xalaeco_contract" model="ir.sequence">
        <field name="name">XALA ECO Contract</field>
        <field name="code">xalaeco.contract</field>
        <field name="prefix">HD</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_xalaeco_payment" model="ir.sequence">
        <field name="name">XALA ECO Payment</field>
        <field name="code">xalaeco.payment</field>
        <field name="prefix">TT</field>
        <field name="padding">5</field>
    </record>

    <data noupdate="1">
        <record id="seq_xalaeco_feedback" model="ir.sequence">
            <field name="name">Feedback Sequence</field>
            <field name="code">xalaeco.feedback</field>
            <field name="prefix">FB</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

</odoo>