<odoo>
    <!-- FORM VIEW -->
    <record id="view_xalaeco_feedback_form" model="ir.ui.view">
        <field name="name">xalaeco.feedback.form</field>
        <field name="model">xalaeco.feedback</field>
        <field name="arch" type="xml">
            <form string="Chi tiết Phản hồi">
                <header>
                    <button name="action_accept" string="Tiếp nhận &amp; Phân công" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reject" string="Từ chối (Không hợp lệ)" type="object" invisible="state != 'draft'"/>
                    <button name="action_close" string="Đóng Ticket" type="object" class="oe_highlight" invisible="state != 'processed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,processed,closed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin Khách hàng">
                            <field name="customer_id"/>
                            <field name="area"/>
                            <field name="route_id"/>
                            <field name="feedback_type"/>
                        </group>
                        <group string="Phân công xử lý">
                            <field name="assigned_employee_id" invisible="state == 'draft'"/>
                            <field name="customer_rating" invisible="state in ('draft', 'received')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nội dung Khiếu nại">
                            <group>
                                <field name="content"/>
                                <field name="evidence_image" widget="image" options="{'size': [250, 250]}"/>
                            </group>
                        </page>
                        <page string="Kết quả Xử lý" invisible="state in ('draft', 'received')">
                            <group>
                                <field name="resolution_note"/>
                                <field name="resolution_image" widget="image" options="{'size': [250, 250]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <!-- Kích hoạt tính năng Chatter chuẩn (Đặt ngoài sheet, trong form) -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_xalaeco_feedback_list" model="ir.ui.view">
        <field name="name">xalaeco.feedback.list</field>
        <field name="model">xalaeco.feedback</field>
        <field name="arch" type="xml">
            <list decoration-danger="state=='draft'" decoration-info="state=='received'" decoration-success="state=='processed'" decoration-muted="state=='closed'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="area"/>
                <field name="feedback_type"/>
                <field name="assigned_employee_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_xalaeco_feedback" model="ir.actions.act_window">
        <field name="name">Quản lý khiếu nại</field>
        <field name="res_model">xalaeco.feedback</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>