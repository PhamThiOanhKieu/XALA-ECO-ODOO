<odoo>
    <record id="view_xalaeco_payment_tree" model="ir.ui.view">
        <field name="name">xalaeco.payment.tree</field>
        <field name="model">xalaeco.payment</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="billing_id"/>
                <field name="amount_due"/>
                <field name="amount_paid"/>
                <field name="debt_amount"/>
                <field name="payment_method"/>
                <field name="xalaeco_contract_status" widget="badge"
                       decoration-success="xalaeco_contract_status == 'active'"
                       decoration-danger="xalaeco_contract_status == 'no_contract'"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_xalaeco_payment_form" model="ir.ui.view">
        <field name="name">xalaeco.payment.form</field>
        <field name="model">xalaeco.payment</field>
        <field name="arch" type="xml">
            <form string="Thanh toán VNPay">
                <header>
                    <button name="action_pay_online"
                            string="Thanh toán TKNH"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'paid' or (xalaeco_contract_status == 'active' and invoice_id == False)"/>
                    <button name="action_confirm_paid"
                            string="Xác nhận đã thu"
                            type="object"
                            class="btn-primary"
                            invisible="payment_method == 'vnpay' or (xalaeco_contract_status == 'active' and invoice_id == False)"/>
                    <button name="action_reset_unpaid"
                            string="Đưa về chưa thanh toán"
                            type="object"
                            class="btn-secondary"
                            invisible="payment_method == 'vnpay' or (xalaeco_contract_status == 'active' and invoice_id == False)"/>
                    <button name="action_create_invoice"
                            string="Tạo hóa đơn"
                            type="object"
                            class="btn-success"
                            invisible="invoice_id != False"/>
                    <field name="xalaeco_contract_status" invisible="1"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="unpaid,partial,paid"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Thông tin thanh toán">
                            <field name="billing_id"/>
                            <field name="contract_id"/>
                            <field name="customer_id"/>
                            <field name="payment_date"/>
                            <field name="payment_method"/>
                            <field name="bank_transaction_code"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>

                        <group string="Số tiền và công nợ">
                            <field name="amount_due"/>
                            <field name="amount_paid"/>
                            <field name="debt_amount"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Ghi chú đối soát">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xalaeco_payment_search" model="ir.ui.view">
        <field name="name">xalaeco.payment.search</field>
        <field name="model">xalaeco.payment</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm thanh toán">
                <field name="name" string="Mã thanh toán"/>
                <field name="customer_id" string="Khách hàng"/>
                <field name="billing_id" string="Kỳ thu phí"/>
                <field name="payment_method" string="Phương thức"/>
                
                <separator/>
                <filter string="Chưa thanh toán" name="filter_unpaid" domain="[('state', '!=', 'paid')]"/>
                <filter string="Đã thanh toán" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Còn nợ" name="filter_debt" domain="[('debt_amount', '>', 0)]"/>
                
                <separator/>
                <filter string="Trạng thái" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                <filter string="Kỳ thu phí" name="group_billing" domain="[]" context="{'group_by': 'billing_id'}"/>
                <filter string="Khách hàng" name="group_customer" domain="[]" context="{'group_by': 'customer_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_xalaeco_payment" model="ir.actions.act_window">
        <field name="name">Thanh toán</field>
        <field name="res_model">xalaeco.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xalaeco_payment_search"/>
    </record>

    <record id="action_xalaeco_debt" model="ir.actions.act_window">
        <field name="name">Công nợ</field>
        <field name="res_model">xalaeco.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('debt_amount','>',0)]</field>
    </record>

    <record id="view_xalaeco_payment_graph" model="ir.ui.view">
        <field name="name">xalaeco.payment.graph</field>
        <field name="model">xalaeco.payment</field>
        <field name="arch" type="xml">
            <graph string="Báo cáo doanh thu" type="bar">
                <field name="billing_id"/>
                <field name="amount_paid" type="measure"/>
                <field name="debt_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_xalaeco_revenue_report" model="ir.actions.act_window">
        <field name="name">Báo cáo doanh thu</field>
        <field name="res_model">xalaeco.payment</field>
        <field name="view_mode">graph,list,form</field>
    </record>
</odoo>